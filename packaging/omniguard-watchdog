#!/bin/sh
# Avvia OmniGuard e lo riavvia automaticamente se si chiude per un crash.
# Una chiusura normale (menu Esci, logout, SIGTERM) termina con codice 0 e NON viene riavviata.
# Usato dall'avvio automatico all'accesso (attivabile dal menu File di OmniGuard).

BIN="$(dirname "$0")/OmniGuard"
[ -x "$BIN" ] || BIN="OmniGuard"

while true; do
    "$BIN" "$@"
    code=$?
    [ "$code" -eq 0 ] && exit 0
    echo "omniguard-watchdog: OmniGuard terminato con codice $code, riavvio tra 3 secondi" >&2
    sleep 3
done
